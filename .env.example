# Copy to .env and fill in. .env is git-ignored — never commit real values.

# === Database ===
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# === Auth ===
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# === Image storage (AWS S3) ===
S3_BUCKET_NAME=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# === Email verification ===
EMAIL_USER=
EMAIL_PASS=

# === Front end (consumed at build time) ===
FRONTEND_BASE_URL=
VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=
